FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git openssh-client rsync curl ca-certificates docker.io python3 gnupg \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /etc/apt/keyrings/cloud.google.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list \
  && apt-get update && apt-get install -y --no-install-recommends google-cloud-cli \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g pm2 --ignore-scripts
WORKDIR /runner
RUN useradd --create-home --shell /usr/sbin/nologin autoship-runner && mkdir -p /data /workspace && chown -R autoship-runner:autoship-runner /data /workspace
COPY package*.json ./
RUN npm install --omit=dev --ignore-scripts
COPY src/runner ./src/runner
COPY src/state ./src/state
USER autoship-runner
ENV NODE_ENV=production
ENV PORT=3100
ENV AUTOSHIP_ENABLE_REAL_RUNNER=true
ENV AUTOSHIP_COMMAND_TIMEOUT_MS=900000
ENV AUTOSHIP_MAX_LOG_BYTES=2097152
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:3100/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "src/runner/runner-service.mjs"]
