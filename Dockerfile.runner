FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git openssh-client rsync curl ca-certificates docker.io python3 && rm -rf /var/lib/apt/lists/*
RUN npm install -g pm2 --ignore-scripts
WORKDIR /runner
RUN useradd --create-home --shell /usr/sbin/nologin autoship-runner && mkdir -p /data /workspace && chown -R autoship-runner:autoship-runner /data /workspace
COPY package*.json ./
RUN npm install --omit=dev --ignore-scripts
COPY src/runner ./src/runner
COPY src/state ./src/state
USER autoship-runner
ENV NODE_ENV=production
ENV AUTOSHIP_ENABLE_REAL_RUNNER=false
ENV AUTOSHIP_COMMAND_TIMEOUT_MS=900000
ENV AUTOSHIP_MAX_LOG_BYTES=2097152
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "import('./src/runner/runner-policy.mjs').then(()=>process.exit(0)).catch(()=>process.exit(1))"
CMD ["node", "-e", "setInterval(() => {}, 2147483647)"]
