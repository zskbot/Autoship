# Autoship production control plane
AUTOSHIP_PORT=3000
AUTOSHIP_CORS_ORIGINS=https://velclaw.cfd
AUTOSHIP_API_TOKEN=replace-with-64-byte-random-token
AUTOSHIP_RUNNER_TOKEN=replace-with-different-64-byte-random-token
AUTOSHIP_DATABASE_URL=postgresql://autoship:replace-me@postgres:5432/autoship
AUTOSHIP_DATABASE_SSL=false
AUTOSHIP_QUEUE_MAX_RETRIES=3
AUTOSHIP_QUEUE_BACKOFF_MS=1500
AUTOSHIP_RUNNER_REQUEST_TIMEOUT_MS=900000

# Runner credentials. Keep these out of the browser and never commit real values.
AUTOSHIP_GITHUB_TOKEN=
AUTOSHIP_TRUSTED_REPOS=https://github.com/zskbot/AgentsIDE
AUTOSHIP_COMMAND_TIMEOUT_MS=900000
AUTOSHIP_MAX_LOG_BYTES=2097152

POSTGRES_DB=autoship
POSTGRES_USER=autoship
POSTGRES_PASSWORD=replace-with-strong-password
