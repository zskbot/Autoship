# Control plane
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
AUTOSHIP_API_TOKEN="CHANGE_ME"
AUTOSHIP_CORS_ORIGINS="https://your-agentside.example"
AUTOSHIP_STATE_FILE="/data/autoship/state.json"
AUTOSHIP_STATE_FLUSH_MS="5000"

# Isolated runner policy
AUTOSHIP_ENABLE_REAL_RUNNER="false"
AUTOSHIP_TRUSTED_REPOS="https://github.com/zskbot/AgentsIDE"
AUTOSHIP_GITHUB_TOKEN="MY_GITHUB_TOKEN"
AUTOSHIP_COMMAND_TIMEOUT_MS="900000"
AUTOSHIP_MAX_LOG_BYTES="2097152"
AUTOSHIP_HEALTHCHECK_TIMEOUT_MS="10000"

# Static / SSH / webhook targets
AUTOSHIP_STATIC_ROOT="/data/sites"
AUTOSHIP_SSH_PRIVATE_KEY="MY_SSH_PRIVATE_KEY"
AUTOSHIP_SSH_KNOWN_HOSTS_FILE="/run/secrets/known_hosts"
AUTOSHIP_SSH_INSECURE="false"
AUTOSHIP_DEPLOY_WEBHOOK_URL="https://deploy.example/internal/deploy"
AUTOSHIP_DEPLOY_WEBHOOK_TOKEN="MY_DEPLOY_TOKEN"

# Docker / Cloud Run targets
AUTOSHIP_DOCKER_IMAGE="registry.example/autoship-app"
AUTOSHIP_DOCKER_PUSH="false"
AUTOSHIP_CLOUDRUN_SERVICE="autoship-app"
AUTOSHIP_CLOUDRUN_REGION="asia-southeast1"
AUTOSHIP_CLOUDRUN_IMAGE=""
